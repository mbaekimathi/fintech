# Copy this file to .env next to manage.py. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=fin.richcom.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://fin.richcom.co.ke
DJANGO_SECURE_SSL=True
DARAJA_PUBLIC_BASE_URL=https://fin.richcom.co.ke

# Approval: 0 = hub paybill payout after app PIN (legacy Lipa flag). 1 = same as phone STK below.
APPROVAL_STK_LIPA_CHARGE=0
# 0 = approve with in-app 6-digit password (default, no charge on reviewer phone). 1 = legacy Lipa STK on phone.
APPROVAL_STK_PHONE_PROMPT=0

DB_NAME=richcomc_fintech
DB_USER=richcomc_fintech
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

USE_SQLITE=False

# Web Push (phone notification tray). Leave blank in DEBUG to auto-create .vapid.json.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CONTACT=mailto:admin@richcom.co.ke
